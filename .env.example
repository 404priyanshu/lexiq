# Copy to .env and fill in. .env is gitignored.

# Postgres (ParadeDB image: pgvector + pg_search BM25)
POSTGRES_USER=lexiq
POSTGRES_PASSWORD=lexiq
POSTGRES_DB=lexiq
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lexiq:lexiq@localhost:5433/lexiq

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# LLM
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# LLM_FALLBACKS=true

# Web -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
