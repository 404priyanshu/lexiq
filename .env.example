# Copy to .env and fill in. .env is gitignored.

# Postgres (ParadeDB image: pgvector + pg_search BM25)
POSTGRES_USER=lexiq
POSTGRES_PASSWORD=lexiq
POSTGRES_DB=lexiq
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lexiq:lexiq@localhost:5433/lexiq

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# LLM: set one key. With both set, Anthropic is used unless LLM_PROVIDER=openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=openai
# Models default to the provider's: claude-opus-5-5, or gpt-4.1-mini for OpenAI.
# LLM_MODEL=claude-opus-5-5
# JUDGE_MODEL=claude-opus-5-5
# OpenAI reasoning models only (gpt-5 and later):
# OPENAI_REASONING_EFFORT=low
# LLM_EFFORT=low
# LLM_FALLBACKS=true

# Web -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
