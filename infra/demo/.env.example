# Copy to .env on the server and fill in. Never commit the filled-in file.

# Public hostname; its DNS A/AAAA records must point at this server for HTTPS.
DOMAIN=lexiq.example.com
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# A key from a separate OpenAI project with a monthly budget limit set.
OPENAI_API_KEY=

# Demo mode (app.config): read-only, per-address limits, and a daily cap on model calls.
READ_ONLY=true
ANSWER_LIMIT_PER_MINUTE=10
ANSWER_LIMIT_PER_DAY=50
SEARCH_LIMIT_PER_MINUTE=30
# ~$0.50/day at gpt-4.1-mini's ~$0.0016 per answer; cached answers don't count.
DAILY_ANSWER_BUDGET=300
